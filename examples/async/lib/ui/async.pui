// `task`: an async value the compiler drives. Nothing here manages a loading flag by hand.

// The host surface: what this file may call, and with what. A call that does not match it — a typo,
// an argument of the wrong type, a future used as a value — is a `.pui` error instead of a Dart one.
import "../data.dart" as data:

    loadTasks(filter: String) -> Future<List<String>>

theme Async:

    color danger = #dc2626
    color muted = #64748b
    space sm = 8
    space md = 16

screen Async:

    task tasks: List<String> = data.loadTasks("")

    state filter: String = ""

    column padding=md gap=sm:

        text "Tasks" style=heading

        input bind=filter placeholder="Filter, or type boom to fail"

        if tasks.loading:

            row gap=sm:
                progress
                text "Loading…" style=caption

        elif tasks.error != null:

            column gap=sm:
                text tasks.error color=danger
                button "Try again":
                    on tap:
                        tasks.retry()

        elif tasks.value.isEmpty:

            text "Nothing matches." style=caption

        else:

            for index, task in tasks.value:

                row gap=sm:
                    text "${index + 1}." style=caption
                    text task
