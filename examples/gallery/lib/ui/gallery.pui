// Every built-in element in one screen: a reference you can render.

// The palette, the spacing scale and the radii live here, once. Everything below refers to them by
// name, so the gallery is also the reference for what a design token looks like in practice.
theme Gallery:

    color brand = #2563eb
    color accent = #16a34a
    color danger = #dc2626
    color surface = #ffffff
    color ink = #0f172a
    color line = #14000000

    space xs = 4
    space sm = 8
    space md = 16
    space lg = 24

    radius card = 12
    radius pill = 999

    shadow soft = [0, 2, 8, #1f000000]
    shadow lifted = [0, 8, 24, #24000000]

// A style is a bundle of properties. `panel` is surface only, so it works on anything that renders
// a box; `mono` and `emphasis` set text properties, so they only apply where text is drawn.
style panel:
    background=surface
    radius=card
    padding=md
    shadow=soft
    border=1
    borderColor=line

style lifted:
    padding=md
    shadow=lifted

style mono:
    fontFamily="monospace"
    size=13

style emphasis:
    size=20
    weight=bold
    color=brand

screen Gallery:

    state name: Text = "Ada"
    state volume: Float = 0.4
    state dark: Bool = false
    state notes: Text = ""

    scaffold title="PlainUI gallery":

        scroll:

            column padding=lg gap=md:

                text "Typography" style=heading
                text "display" style=display
                text "heading" style=heading
                text "subheading" style=subheading
                text "body — the quick brown fox jumps over the lazy dog"
                text "caption" style=caption
                text "label" style=label
                text "secondary" style=secondary
                text "monospace" style=mono

                divider

                text "Layout" style=heading

                row gap=sm main=between:
                    text "spaceBetween"
                    text "row"

                wrap gap=xs:
                    text "wrap"
                    text "wraps"
                    text "children"

                grid columns=3 gap=sm:
                    card style=panel padding=sm:
                        center:
                            text "1"
                    card style=panel padding=sm:
                        center:
                            text "2"
                    card style=panel padding=sm:
                        center:
                            text "3"

                stack:
                    card style=lifted padding=lg:
                        text "stack"
                    text "over" style=caption

                spacer

                divider

                text "Inputs" style=heading

                input bind=name label="Name" placeholder="Your name"
                input placeholder="Search" keyboard=email
                input bind=notes label="Notes" multiline maxLines=4
                input placeholder="Password" secret

                checkbox bind=dark label="Dark mode"
                toggle bind=dark label="Same state, different control"
                slider bind=volume min=0 max=1 divisions=10

                divider

                text "Actions" style=heading

                row gap=sm:
                    button "Filled"
                    button "Outlined" variant=outlined
                    button "Text" variant=text

                row gap=sm:
                    button "Full width" fullWidth
                    button "Disabled" disabled

                row gap=sm:
                    icon star
                    icon heart color=danger
                    icon settings size=32

                divider

                text "State" style=heading
                text "name = ${name}"
                text "volume = ${volume}"
                text "dark = ${dark}"

                progress value=0.6
                progress color=accent

                row gap=md cross=center:
                    progress
                    text "loading…" style=caption

                divider

                text "Design tokens" style=heading
                text "the same names in Dart (GalleryTokens) and in CSS (--pui-brand)" style=caption

                row gap=sm:
                    card padding=md background=brand radius=card:
                        text "brand" color=surface
                    card padding=md background=accent radius=card:
                        text "accent" color=surface
                    card padding=md background=danger radius=card:
                        text "danger" color=surface

                divider

                text "Styles" style=heading
                text "a style decorates any element; a text style only decorates text" style=caption

                // Surface only: works on a column, a card, a button.
                column style=panel gap=sm:
                    text "panel style on a column"
                    text "padding, background, radius, border and shadow, from one declaration" style=caption

                row gap=sm:
                    card style=lifted:
                        text "lifted" style=caption
                    // An explicit property wins over the style it is combined with.
                    card style=panel background=accent:
                        text "override" style=caption color=surface
                    button "emphasis" style=emphasis
