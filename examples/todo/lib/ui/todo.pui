import "task_row.pui"

// Lists, method calls on state and a counter all in one screen.

screen Todo:

    state draft: Text = ""
    state tasks: List<Text> = ["Write the spec", "Build the compiler"]
    state done: Int = 0

    column padding=20 gap=12:

        text "Today" style=heading
        text "$done done" style=caption

        row gap=8:
            expanded:
                input bind=draft placeholder="What needs doing?"
            button "Add":
                on tap:
                    tasks.add(draft)
                    set draft = ""

        column gap=8:
            for index, task in tasks key=task:
                TaskRow(task):
                    button "Finish" variant=text size=12:
                        on tap:
                            tasks.remove(task)
                            set done = done + 1

        if tasks.length == 0:
            center:
                column gap=4:
                    icon check size=32
                    text "Nothing left for today" style=secondary
