// `screen Detail(id: String, title: String = "Task")` — a destination with parameters.
// The second one has a default, so `navigate Detail(id: "2")` is legal and `title` falls back.

screen Detail(id: Text, title: Text = "Task"):

    column padding=20 gap=12:

        text title style=heading
        text "Item ${id}" style=caption
        text "Opened by name, closed by back()."

        button "Back" variant=text:
            on tap: back()
